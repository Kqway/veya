{
  "name": "veya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/database.ts migrate",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/database.ts seed",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:cleanup": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/retention.ts",
    "social:process": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/social-worker.ts",
    "notifications:process": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/notifications.ts",
    "analytics:funnel": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/funnel.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "next": "16.3.8",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
