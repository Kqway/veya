# Copy to .env.local. The landing page needs none of the external service values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional for landing; required for backend APIs. PostgreSQL / Supabase URI.
# db:local development URI: postgresql://veya:veya-local-only@127.0.0.1:54322/veya
# Include the provider's TLS options for hosted databases; never disable TLS checks.
DATABASE_URL=

# Only mock is implemented in Phase 1. OpenAI integration arrives in Phase 5.
AI_PROVIDER=mock
# Reserved server-only secret; leave empty for local development.
OPENAI_API_KEY=

# Opt into safe PostgreSQL intent_created/participant_joined events (no PII).
ANALYTICS_ENABLED=false
