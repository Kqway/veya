# Copy to .env.local. The landing page needs none of the external service values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional for landing; required for persistent plan APIs. PostgreSQL / Supabase URI.
# db:local development URI: postgresql://veya:veya-local-only@127.0.0.1:54322/veya
# Include the provider's TLS options for hosted databases; never disable TLS checks.
DATABASE_URL=

# Optional assistance works locally with mock; openai enables the remote provider.
AI_PROVIDER=mock
# Server-only secret; missing keys and provider failures use local fallback.
OPENAI_API_KEY=
# Optional remote model (default shown); restart after configuration changes.
OPENAI_MODEL=gpt-4.1-mini

# Opt into nine bounded entry/result events in PostgreSQL (no PII).
ANALYTICS_ENABLED=false
