# Copy to .env.local. The landing page needs none of the external service values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional for landing; required for persistent plan APIs. PostgreSQL / Supabase URI.
# db:local development URI: postgresql://veya:veya-local-only@127.0.0.1:54322/veya
# Include the provider's TLS options for hosted databases; never disable TLS checks.
DATABASE_URL=

# Machine-only scheduler credential: 32+ random base64url characters. Optional locally.
# Vercel Cron sends Authorization: Bearer CRON_SECRET. Never use NEXT_PUBLIC.
CRON_SECRET=

# Optional assistance works locally with mock; openai enables the remote provider.
AI_PROVIDER=mock
# Server-only secret; missing keys and provider failures use local fallback.
OPENAI_API_KEY=
# Optional remote model (default shown); restart after configuration changes.
OPENAI_MODEL=gpt-4.1-mini

# Opt into nine entry/result and eight server-only funnel events (no PII).
ANALYTICS_ENABLED=false

# Server-only closed beta controls: exact true/false; restart web and workers after changes.
# Defaults keep signup/seeking enabled and the application writable. Never use NEXT_PUBLIC.
BETA_SIGNUPS_ENABLED=true
BETA_SEEKING_ENABLED=true
BETA_READ_ONLY=false
# Read-only keeps reads, health, deletion, revocations, push opt-out and human safety actions.
# Discovery pauses; cached results remain readable without result-cache writes.
# Operational quotas and explicit safety actions can still write; this is not DB-level read-only.

# Query pool per web/worker instance; include one additional session LISTEN connection.
DB_POOL_MAX=5
# Optional verified database TLS. Trust provider CA via NODE_EXTRA_CA_CERTS if needed.
# Use verify-full; never disable certificate/hostname checks for remote production.
# Vercel + explicit verify-full upgrades Neon's single sslmode=require default safely.
DATABASE_SSL_MODE=
# Optional separate session-mode PostgreSQL URL for LISTEN (no transaction pooling).
# On Vercel, an absent value uses Marketplace DATABASE_URL_UNPOOLED; no copying needed.
REALTIME_DATABASE_URL=
# Marketplace-owned direct credential; server-only, production-only. Not needed on VPS.
DATABASE_URL_UNPOOLED=
REALTIME_ENABLED=true
# Blank chooses postgres in production and memory in development/test.
RATE_LIMIT_BACKEND=

# Optional moderation: generate a random 32+ character base64url key; keep server-only.
MODERATION_ADMIN_SECRET=

# Optional Web Push: all three required together; HTTPS public origin also required.
# Standard unpadded base64url VAPID keys (public87/private43); never NEXT_PUBLIC secrets.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
